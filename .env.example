# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in your Vercel project settings for
# production. Get all values from Supabase Dashboard → Project Settings → API.

# Safe to expose to the browser (used for public reads + admin login).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# NEVER prefix this with VITE_ — it must stay server-side only. Used by the
# /api serverless functions (and scripts/seed.ts) to bypass Row Level
# Security for writes. Do not commit this value or expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — WhatsApp Business Cloud API (business.facebook.com → WhatsApp →
# API Setup), used to send an automated booking confirmation. Leave unset
# and booking confirmations simply won't be sent over WhatsApp (everything
# else keeps working — this never blocks a booking).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_TOKEN=
# The name of an approved message template in your WhatsApp Business
# account (Meta requires pre-approved templates for the first message in a
# conversation). Must accept exactly 3 body parameters, in order: customer
# name, package title, booking id.
WHATSAPP_TEMPLATE_NAME=booking_confirmation
